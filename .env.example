# TankIT – Environment Variables
# Copy this file to .env and fill in your values.
# The app works in LOCAL DEMO MODE without any configuration.
# To enable community price sharing across all users, set up a free Supabase project.

# ── Optional: Supabase (community prices shared across all users) ──
# 1. Create a free project at https://supabase.com
# 2. Run supabase/schema.sql in the SQL Editor
# 3. Copy your project URL and anon key here
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Without Supabase, prices are stored in your browser only (localStorage).
# Perfect for personal use or testing. For a real community app, add Supabase above.

# TankIT – environment variables (copy to .env for local development)
# Everything is optional: without any key the app uses the bundled
# OpenStreetMap station list and community-reported prices.

# ── Official prices (MTS-K) via the free Tankerkönig API ──
# Key for the free Tankerkönig fuel-price API.
# Register for your own key at https://creativecommons.tankerkoenig.de
# Never commit a real key – in production it is the GitHub secret TANKERKOENIG_API_KEY.
VITE_TANKERKOENIG_API_KEY=

# ── Shared community prices (optional) ──
# Free Supabase project; run supabase/schema.sql, then paste URL + anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
